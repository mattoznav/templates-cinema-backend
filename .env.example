# Copy to .env and adjust. Never commit the real .env.
DEBUG=true
# Required when DEBUG is false. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4200
TIME_ZONE=Europe/Rome

# Leave empty to use the local SQLite file rebuilt from data/*.csv
DATABASE_URL=

# Created by `manage.py load_data` when both are set
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=

# Payments: "fake" works offline. Set the Stripe keys (test mode) to use Stripe.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
